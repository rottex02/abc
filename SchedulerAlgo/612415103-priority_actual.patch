@@ -197,6 +201,7 @@ fork(void)
     return -1;
   }
   np->sz = curproc->sz;
+  np->priority = curproc->priority;
   np->parent = curproc;
   *np->tf = *curproc->tf;
 
@@ -332,6 +337,36 @@ scheduler(void)
 
     // Loop over process table looking for process to run.
     acquire(&ptable.lock);
+
+  #if SCHEDPOLICY == SCHED_PRIORITY
+    {
+      struct proc *best = 0;
+
+      // Phase 1: scan the whole table. Highest priority wins;
+      // among equals, the least recently run wins (round-robin).
+      for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+        if(p->state != RUNNABLE)
+          continue;
+        if(best == 0 || p->priority > best->priority ||
+           (p->priority == best->priority && p->lastrun < best->lastrun))
+          best = p;
+      }
+
+      // Phase 2: run it until the next timer tick.
+      if(best){
+        p = best;
+        p->lastrun = ++schedclock;
+        c->proc = p;
+        switchuvm(p);
+        p->state = RUNNING;
+
+        swtch(&(c->scheduler), p->context);
+        switchkvm();
+
+        c->proc = 0;
+      }
+    }
+  #else
     for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
       if(p->state != RUNNABLE)
         continue;
@@ -350,6 +385,7 @@ scheduler(void)
       // It should have changed its p->state before coming back.
       c->proc = 0;
     }
+  #endif
     release(&ptable.lock);
 
   }
@@ -532,3 +568,15 @@ procdump(void)
     cprintf("\n");
   }
 }
+
+
+int
+nice(int n)
+{
+  if(n < MINPRIORITY || n > MAXPRIORITY)
+    return -1;
+  acquire(&ptable.lock);
+  myproc()->priority = n;
+  release(&ptable.lock);
+  return 0;
+}
