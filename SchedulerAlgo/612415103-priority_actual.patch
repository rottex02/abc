--- a/proc.c
+++ b/proc.c
@@ -12,6 +12,8 @@ struct {
   struct proc proc[NPROC];
 } ptable;
 
+static uint schedclock;  
+
 static struct proc *initproc;
 
 int nextpid = 1;
@@ -88,6 +90,8 @@ allocproc(void)
 found:
   p->state = EMBRYO;
   p->pid = nextpid++;
+  p->priority = DEFPRIORITY;
