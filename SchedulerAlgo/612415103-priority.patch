diff --git a/proc.c b/proc.c
index 806b1b1..694e2e2 100644
--- a/proc.c
+++ b/proc.c
@@ -88,6 +88,7 @@ allocproc(void)
 found:
   p->state = EMBRYO;
   p->pid = nextpid++;
+  p->priority = DEFPRIORITY;
 
   release(&ptable.lock);
 
@@ -200,6 +201,8 @@ fork(void)
   np->parent = curproc;
   *np->tf = *curproc->tf;
 
+  np->priority = curproc->priority;
+
   // Clear %eax so that fork returns 0 in the child.
   np->tf->eax = 0;
 
@@ -343,6 +346,8 @@ scheduler(void)
       switchuvm(p);
       p->state = RUNNING;
 
+      lapictimerset(p->priority * QUANTUM_UNIT);
+
       swtch(&(c->scheduler), p->context);
       switchkvm();
 
@@ -532,3 +537,14 @@ procdump(void)
     cprintf("\n");
   }
 }
+
+int
+nice(int n)
+{
+  if(n < MINPRIORITY || n > MAXPRIORITY)
+    return -1;
+  acquire(&ptable.lock);
+  myproc()->priority = n;
+  release(&ptable.lock);
+  return 0;
+}
