diff --git a/proc.c b/proc.c
index 806b1b1..6fea9a9 100644
--- a/proc.c
+++ b/proc.c
@@ -88,6 +88,7 @@ allocproc(void)
 found:
   p->state = EMBRYO;
   p->pid = nextpid++;
+  p->burst= DEFBURST;
 
   release(&ptable.lock);
 
@@ -332,24 +333,56 @@ scheduler(void)
 
     // Loop over process table looking for process to run.
     acquire(&ptable.lock);
-    for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
-      if(p->state != RUNNABLE)
-        continue;
 
-      // Switch to chosen process.  It is the process's job
-      // to release ptable.lock and then reacquire it
-      // before jumping back to us.
-      c->proc = p;
-      switchuvm(p);
-      p->state = RUNNING;
+    #if SCHEDPOLICY == SCHED_SJF
+    {
+      struct proc *best = 0;
+
+     
+      for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+        if(p->state != RUNNABLE)
+          continue;
+        if(best == 0 || p->burst < best->burst ||
+           (p->burst == best->burst && p->pid < best->pid))
+          best = p;
+      }
+
+      
+      if(best){
+        p = best;
+        c->proc = p;
+        switchuvm(p);
+        p->state = RUNNING;
 
-      swtch(&(c->scheduler), p->context);
-      switchkvm();
+        swtch(&(c->scheduler), p->context);
+        switchkvm();
 
-      // Process is done running for now.
-      // It should have changed its p->state before coming back.
-      c->proc = 0;
+        c->proc = 0;
+      }
     }
+
+
+    #else
+      for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+        if(p->state != RUNNABLE)
+          continue;
+
+        // Switch to chosen process.  It is the process's job
+        // to release ptable.lock and then reacquire it
+        // before jumping back to us.
+        c->proc = p;
+        switchuvm(p);
+        p->state = RUNNING;
+
+        swtch(&(c->scheduler), p->context);
+        switchkvm();
+
+        // Process is done running for now.
+        // It should have changed its p->state before coming back.
+        c->proc = 0;
+      }
+
+    #endif
     release(&ptable.lock);
 
   }
@@ -532,3 +565,29 @@ procdump(void)
     cprintf("\n");
   }
 }
+
+
+int
+setburst(int pid, int burst)
+{
+  struct proc *p;
+
+  if(burst <= 0)
+    return -1;
+
+  acquire(&ptable.lock);
+  if(pid <= 0){
+    myproc()->burst = burst;
+    release(&ptable.lock);
+    return 0;
+  }
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->pid == pid && p->state != UNUSED){
+      p->burst = burst;
+      release(&ptable.lock);
+      return 0;
+    }
+  }
+  release(&ptable.lock);
+  return -1;
+}
